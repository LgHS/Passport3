# Authentik OAuth2/OIDC provider settings.
# In Authentik: create a Provider (OAuth2/OIDC, Confidential client, Authorization Code + PKCE)
# and an Application bound to it, with its redirect URI matching AUTHENTIK_REDIRECT_URI below.

# Issuer URL of the Authentik application, e.g. https://auth.lghs.be/application/o/passport3/
AUTHENTIK_ISSUER=

AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# Must exactly match the redirect URI configured on the Authentik provider.
AUTHENTIK_REDIRECT_URI=http://localhost:5173/login/callback

# Service-account API token used server-side to read/update user profiles, list members, and
# create onboarding invitations (Authentik admin -> Directory -> Tokens). Distinct from
# AUTHENTIK_CLIENT_SECRET above. Never exposed to the client.
AUTHENTIK_API_TOKEN=

# Name of the Authentik group whose members can access the /admin panel. Exposed to the client
# (PUBLIC_ prefix) since the nav link visibility check runs there too — not a secret.
PUBLIC_AUTHENTIK_ADMIN_GROUP=Passport Admin

# Slug of the enrollment flow used to build onboarding invitation links
# (Authentik admin -> Flows & Stages -> Flows).
AUTHENTIK_ENROLLMENT_FLOW_SLUG=lghs-enrollment-flow

# Note: the invitation email's template is NOT configured here — this Authentik instance's
# version doesn't support overriding it per-request (see createInvitation() in
# src/lib/server/authentikAdmin.ts for why). Set the custom LGHS template directly on the Email
# stage bound to the invitation flow, in Authentik's own admin UI, instead.

# Dolibarr REST API, used to read the member's cotisation (subscription) status and history.
# Base URL of the Dolibarr instance (no trailing slash needed), e.g. https://dolibarr.lghs.be
DOLIBARR_URL=

# API key for a Dolibarr user with read access to members/subscriptions (Dolibarr:
# Home -> Setup -> Users -> [user] -> API key). Never exposed to the client.
DOLIBARR_API_KEY=

# GitHub OAuth App, used to verify a member owns the GitHub account they want invited to the org
# with (org invitations themselves go through a separate service token, not this one).
# In GitHub: Settings -> Developer settings -> OAuth Apps -> New OAuth App, created on the org
# account. Use a separate app per environment (dev/preprod/prod) rather than one app with several
# callback URLs, so a leaked dev secret can't be replayed against prod.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Must exactly match the callback URL configured on the GitHub OAuth App.
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/github/callback

# GitHub App used server-side to actually send org invitations (the privileged action — distinct
# from the OAuth App above, which only verifies identity). Created on the org's own settings
# (Settings -> Developer settings -> GitHub Apps -> New GitHub App), with only the
# "Organization permissions -> Members: Read and write" permission, installed on the org itself.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=

# The App's private key (.pem, downloaded once from the App's settings page), base64-encoded —
# e.g. `base64 -i github-app-private-key.pem | tr -d '\n'` — then pasted as a single line here.
# Simpler and safer to deploy than a file path: one secret to inject, nothing to mount, and no risk
# of the key file ending up inside the repo working tree on a branch whose .gitignore doesn't
# exclude it.
GITHUB_APP_PRIVATE_KEY_BASE64=

# Shown in the URL after installing the App on the org (.../installations/<this number>).
GITHUB_APP_INSTALLATION_ID=

# Org slug the invitations are sent to, e.g. LgHS.
GITHUB_ORG=

# Mattermost, used to match a member's Mattermost username to their Authentik account by email
# (e.g. for the trombinoscope's "Pseudo Chat" field). Base URL of the Mattermost instance (no
# trailing slash), e.g. https://chat.lghs.be
MATTERMOST_URL=

# Personal Access Token for a Mattermost account allowed to list users (System Console ->
# Integrations -> Integration Management to enable PATs, then Account Settings -> Security ->
# Personal Access Tokens on the account itself). Read-only use (listing users) — prefer a
# dedicated service account over a personal one. Never exposed to the client.
MATTERMOST_TOKEN=

# Slug (not display name) of the team members' DM links should open in — check via
# GET /api/v4/teams. Instances can have several teams; pick the one members actually use (a
# near-empty leftover team is easy to pick by mistake, check member counts via
# GET /api/v4/teams/{id}/stats first).
MATTERMOST_TEAM_SLUG=

# Token for a dedicated Mattermost Bot Account (System Console -> Integrations -> Bot Accounts),
# used to actually post messages — to an admin channel and/or DM a member directly — unlike
# MATTERMOST_TOKEN above, which only reads. With the "system_post_all" role it can post to any
# channel without being added as a member first (confirmed via GET /api/v4/users/me — check the
# bot's own `roles` if unsure). Never exposed to the client.
MATTERMOST_BOT_TOKEN=

# The bot account's own user id — GET /api/v4/users/me with MATTERMOST_BOT_TOKEN returns it.
# Needed to open a DM channel with a member (POST /api/v4/channels/direct expects both
# participant ids explicitly). Fixed for a given bot account, so stored here rather than
# re-resolved at runtime.
MATTERMOST_BOT_ID=
